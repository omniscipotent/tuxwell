#!/usr/bin/env bash
# tuxwell: applies Audeze Maxwell settings only while the dongle/headset is connected,
# and undoes them when it is unplugged. Runs as a systemd user service.
set -u
umask 077
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/tuxwell/tuxwell.conf"
SURROUND="${XDG_CONFIG_HOME:-$HOME/.config}/tuxwell/surround.conf"
# defaults (override in tuxwell.conf)
HW_VOLUME=86                    # dongle hardware PCM, 0-96 (1 step = 1 dB, 96 = 0 dB)
RATES="48000 96000"
DISABLE_MIC=1                   # 1 = playback-only card profile (headset mic hidden)
SURROUND_ENABLED=1
HIRES=1
SURROUND_GAIN=0.27               # per-speaker gain; 0.27 makes centred stereo as loud as the stereo output
CENTER_DB=3                      # extra dB on the centre channel, so 5.1 dialogue matches a stereo downmix
SURROUND_APPS='tv.plex.PlexHTPC|Plex HTPC'
HRTF=D1_48K_24bit_256tap_FIR_SOFA.sofa   # head-response file in ~/.local/share/tuxwell/hrtf (see tuxwell-hrtf)
AUTO_DEFAULT=1                   # 1 = the default output follows playback: surround while PLAYING_APPS plays, stereo otherwise
PLAYING_APPS='plex-bin'          # regex for the player's own stream (not its menu/UI sounds)
# Read the config as data, never as code: only known keys, only plain values.
if [ -f "$CONF" ]; then
  while IFS='=' read -r key val; do
    val=${val%\'}; val=${val#\'}; val=${val%\"}; val=${val#\"}
    case "$key" in
      HW_VOLUME)        [[ $val =~ ^[0-9]+$ ]] && [ "$val" -le 96 ] && HW_VOLUME=$val ;;
      DISABLE_MIC)      [[ $val =~ ^[01]$ ]] && DISABLE_MIC=$val ;;
      SURROUND_ENABLED) [[ $val =~ ^[01]$ ]] && SURROUND_ENABLED=$val ;;
      HIRES)            [[ $val =~ ^[01]$ ]] && HIRES=$val ;;
      SURROUND_GAIN)    [[ $val =~ ^[0-9]*\.?[0-9]+$ ]] && awk "BEGIN{exit !($val > 0 && $val <= 1.5)}" && SURROUND_GAIN=$val ;;
      CENTER_DB)        [[ $val =~ ^[0-9]+(\.[0-9]+)?$ ]] && awk "BEGIN{exit !($val <= 9)}" && CENTER_DB=$val ;;
      HRTF)             [[ $val =~ ^[A-Za-z0-9._-]+\.sofa$ ]] && HRTF=$val ;;
      AUTO_DEFAULT)     [[ $val =~ ^[01]$ ]] && AUTO_DEFAULT=$val ;;
      PLAYING_APPS)     [[ $val =~ ^[A-Za-z0-9\ ._\|-]*$ ]] && PLAYING_APPS=$val ;;
      SURROUND_APPS)    [[ $val =~ ^[A-Za-z0-9\ ._\|-]*$ ]] && SURROUND_APPS=$val ;;
    esac
  done < "$CONF"
fi

present=0; surround_pid=""; runconf=""; last_play=0
# The dongle stays on the USB bus when the headset powers off, but its audio sink disappears.
connected() { pactl list short sinks 2>/dev/null | grep -q "Audeze"; }
card_name() { pactl list short cards | awk '/Audeze/ {print $2; exit}'; }
alsa_card() { awk '/^ *[0-9]+ \[/ && /Audeze/ {print $1; exit}' /proc/asound/cards 2>/dev/null; }

apply() {
  local card n hrtf_path; card=$(card_name); n=$(alsa_card)
  [ "$DISABLE_MIC" = 1 ] && [ -n "$card" ] && pactl set-card-profile "$card" output:iec958-stereo 2>/dev/null
  if [ -n "$n" ]; then amixer -c "$n" sset 'PCM',0 "$HW_VOLUME" >/dev/null; amixer -c "$n" sset 'PCM',1 "$HW_VOLUME" >/dev/null; fi
  [ "$HIRES" = 1 ] && pw-metadata -n settings 0 clock.allowed-rates "[ $RATES ]" >/dev/null
  if [ "$SURROUND_ENABLED" = 1 ] && [ -f "$SURROUND" ]; then
    runconf=$(mktemp --suffix=.conf "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/tuxwell-surround.XXXXXX") || return   # PipeWire needs the .conf suffix
    hrtf_path="${XDG_DATA_HOME:-$HOME/.local/share}/tuxwell/hrtf/$HRTF"
    [ -f "$hrtf_path" ] || hrtf_path="${XDG_DATA_HOME:-$HOME/.local/share}/tuxwell/hrtf/D1_48K_24bit_256tap_FIR_SOFA.sofa"
    awk -v g="$SURROUND_GAIN" -v db="$CENTER_DB" -v hf="$hrtf_path" '
      /name = spFC/ { fc = 1 }
      /gain = [0-9.]+/ { v = g; if (fc) { v = g * 10 ^ (db / 20); fc = 0 }; sub(/gain = [0-9.]+/, sprintf("gain = %.4f", v)); sub(/filename = "[^"]*"/, "filename = \"" hf "\"") }
      { print }' "$SURROUND" > "$runconf"
    pipewire -c "$runconf" & surround_pid=$!
  fi
  echo "tuxwell: applied"
}
revert() {
  [ -n "$surround_pid" ] && kill "$surround_pid" 2>/dev/null; surround_pid=""
  [ -n "$runconf" ] && rm -f "$runconf"; runconf=""
  pw-metadata -n settings 0 clock.allowed-rates "[ 48000 ]" >/dev/null
  echo "tuxwell: reverted"
}

# Send streams from chosen apps (SURROUND_APPS, a regex matched against each stream's properties)
# to the surround sink. Everything else stays on the default output (stereo).
route_apps() {
  [ -n "$SURROUND_APPS" ] || return 0
  local sid idx cur
  sid=$(pactl list short sinks | awk '$2=="tuxwell_surround" {print $1}')
  [ -n "$sid" ] || return 0
  pactl list sink-inputs | awk -v re="$SURROUND_APPS" '
    /^Sink Input #/ { if (idx != "" && hit) print idx; idx=substr($3,2); hit=0 }
    $0 ~ re { hit=1 }
    END { if (idx != "" && hit) print idx }' | while read -r idx; do
      cur=$(pactl list short sink-inputs | awk -v i="$idx" '$1==i {print $2}')
      if [ "$cur" != "$sid" ] && pactl move-sink-input "$idx" tuxwell_surround 2>/dev/null; then
        echo "tuxwell: moved stream $idx to surround"
      fi
    done
}
# True while a player stream (PLAYING_APPS) is actually playing (not corked).
is_playing() {
  [ -n "$PLAYING_APPS" ] || return 1
  pactl list sink-inputs | awk -v re="$PLAYING_APPS" 'BEGIN{RS="";FS="\n"} $0 ~ re && /Corked: no/ {f=1} END{exit !f}'
}

# Make the default output follow playback, so the volume keys and the volume pop-up show the right output.
# One volume for both outputs: the output being left hands its level to the one taking over and returns to 100%.
auto_default() {
  [ "$AUTO_DEFAULT" = 1 ] || return 0
  local sid aud def want lvl now
  sid=tuxwell_surround
  pactl list short sinks | grep -q "$sid" || return 0
  aud=$(pactl list short sinks | awk '/Audeze/ {print $2; exit}'); [ -n "$aud" ] || return 0
  def=$(pactl get-default-sink 2>/dev/null)
  [ "$def" = "$sid" ] || [ "$def" = "$aud" ] || return 0     # the user chose something else: leave it
  now=$(date +%s)
  if is_playing; then last_play=$now; want=$sid
  elif [ "$def" = "$sid" ] && [ $((now - last_play)) -lt 4 ]; then return 0   # hold surround briefly (episode changes)
  else want=$aud; fi
  [ "$def" = "$want" ] && return 0
  lvl=$(pactl get-sink-volume "$def" | awk -F'/' 'NR==1{gsub(/ /,"",$2); print $2}')
  if [ -n "$lvl" ]; then pactl set-sink-volume "$want" "$lvl"; pactl set-sink-volume "$def" 100%; fi
  pactl set-default-sink "$want"
  echo "tuxwell: default output -> $([ "$want" = "$sid" ] && echo surround || echo stereo)"
}

check() {
  if connected; then [ $present = 0 ] && { sleep 2; apply; present=1; sleep 2; }
    route_apps
    auto_default
  else [ $present = 1 ] && { revert; present=0; }; fi
}
trap 'revert; exit 0' TERM INT
check
# React to streams, sinks and cards appearing, changing or going away. A stream's properties (such as the
# app name) can arrive just after it is created, so changes matter too. Bursts are coalesced, and a
# re-check every 5 s catches anything missed.
pactl subscribe | grep --line-buffered -E "'(new|change|remove)' on (sink|card|sink-input) " | while true; do
  read -r -t 5 _; rc=$?
  [ "$rc" -eq 1 ] && break                                  # the event stream ended
  [ "$rc" -eq 0 ] && while read -r -t 0.3 _; do :; done     # coalesce a burst of events
  check
done
