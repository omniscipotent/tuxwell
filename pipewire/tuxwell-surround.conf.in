# Maxwell surround: 7.1 -> binaural virtual sink (SADIE II D1 HRTF via PipeWire's `sofa` plugin).
# Run as its own client:  pipewire -c <this file>   (tuxwell does this only while the headset is connected)
# Template: install.sh fills in @HRTF@, @GAIN@ and @TARGET@.
# Angles: SOFA convention, 0 = front, counter-clockwise (90 = left).

context.properties = {
    log.level = 0
}

context.spa-libs = {
    audio.convert.* = audioconvert/libspa-audioconvert
    support.*       = support/libspa-support
}

context.modules = [
    { name = libpipewire-module-rt args = { } flags = [ ifexists nofail ] }
    { name = libpipewire-module-protocol-native }
    { name = libpipewire-module-client-node }
    { name = libpipewire-module-adapter }

    { name = libpipewire-module-filter-chain
        flags = [ nofail ]
        args = {
            node.description = "Tuxwell Surround (7.1)"
            media.name       = "Tuxwell Surround (7.1)"
            filter.graph = {
                nodes = [
                    { type = sofa label = spatializer name = spFL
                      config = { filename = "@HRTF@" gain = @GAIN@ }
                      control = { "Azimuth" = 30.0 "Elevation" = 0.0 "Radius" = 2.0 } }
                    { type = sofa label = spatializer name = spFR
                      config = { filename = "@HRTF@" gain = @GAIN@ }
                      control = { "Azimuth" = 330.0 "Elevation" = 0.0 "Radius" = 2.0 } }
                    { type = sofa label = spatializer name = spFC
                      config = { filename = "@HRTF@" gain = @GAIN@ }
                      control = { "Azimuth" = 0.0 "Elevation" = 0.0 "Radius" = 2.0 } }
                    { type = sofa label = spatializer name = spSL
                      config = { filename = "@HRTF@" gain = @GAIN@ }
                      control = { "Azimuth" = 90.0 "Elevation" = 0.0 "Radius" = 2.0 } }
                    { type = sofa label = spatializer name = spSR
                      config = { filename = "@HRTF@" gain = @GAIN@ }
                      control = { "Azimuth" = 270.0 "Elevation" = 0.0 "Radius" = 2.0 } }
                    { type = sofa label = spatializer name = spRL
                      config = { filename = "@HRTF@" gain = @GAIN@ }
                      control = { "Azimuth" = 150.0 "Elevation" = 0.0 "Radius" = 2.0 } }
                    { type = sofa label = spatializer name = spRR
                      config = { filename = "@HRTF@" gain = @GAIN@ }
                      control = { "Azimuth" = 210.0 "Elevation" = 0.0 "Radius" = 2.0 } }
                    { type = builtin label = copy  name = inLFE }
                    { type = builtin label = mixer name = mixL }
                    { type = builtin label = mixer name = mixR }
                ]
                links = [
                    { output = "spFL:Out L" input = "mixL:In 1" }
                    { output = "spFL:Out R" input = "mixR:In 1" }
                    { output = "spFR:Out L" input = "mixL:In 2" }
                    { output = "spFR:Out R" input = "mixR:In 2" }
                    { output = "spFC:Out L" input = "mixL:In 3" }
                    { output = "spFC:Out R" input = "mixR:In 3" }
                    { output = "spSL:Out L" input = "mixL:In 4" }
                    { output = "spSL:Out R" input = "mixR:In 4" }
                    { output = "spSR:Out L" input = "mixL:In 5" }
                    { output = "spSR:Out R" input = "mixR:In 5" }
                    { output = "spRL:Out L" input = "mixL:In 6" }
                    { output = "spRL:Out R" input = "mixR:In 6" }
                    { output = "spRR:Out L" input = "mixL:In 7" }
                    { output = "spRR:Out R" input = "mixR:In 7" }
                    { output = "inLFE:Out" input = "mixL:In 8" }
                    { output = "inLFE:Out" input = "mixR:In 8" }
                ]
                inputs  = [ "spFL:In" "spFR:In" "spFC:In" "inLFE:In" "spSL:In" "spSR:In" "spRL:In" "spRR:In" ]
                outputs = [ "mixL:Out" "mixR:Out" ]
            }
            capture.props = {
                node.name      = "tuxwell_surround"
                media.class    = Audio/Sink
                audio.channels = 8
                audio.position = [ FL FR FC LFE SL SR RL RR ]
            }
            playback.props = {
                node.name         = "tuxwell_surround.output"
                node.passive      = true
                node.dont-fallback = true
                target.object     = "@TARGET@"
                audio.channels    = 2
                audio.position    = [ FL FR ]
            }
        }
    }
]
