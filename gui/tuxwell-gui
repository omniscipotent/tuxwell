# Paths and constants
# ----------------------------------------------------------------------------------------------------------------------
CFG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "tuxwell")
CFG = os.path.join(CFG_DIR, "tuxwell.conf")                  # the settings file shared with bin/tuxwell
DATA_DIR = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "tuxwell")
CATALOG = os.path.join(DATA_DIR, "hrtf-catalog.tsv")        # head-response sets (written by install.sh)
EQ_CATALOG = os.path.join(DATA_DIR, "eq", "catalog.tsv")    # headphone-correction profiles
DEFAULT_CTL = os.path.join(DATA_DIR, "audezeforlinux", "maxwell_ctl.py")   # where the README tells people to clone it
SURROUND_SINK = "tuxwell_surround"                          # node name of the virtual surround output (see bin/tuxwell)
FILTER_STREAM = re.compile(r"tuxwell_surround|Tuxwell Surround")   # marks the surround filter's own output stream
RATES_ON = "48000 96000"                                    # the dongle has no 44.1 kHz mode
PRESETS = ["Audeze", "Treble Boost", "Bass Boost", "Immersive", "Competition", "Footsteps",
           "EQ 1 (custom)", "EQ 2 (custom)", "EQ 3 (custom)", "EQ 4 (custom)"]   # headset preset N is sent as PRESETS index + 1
DONGLE_HID = "3329:00004B28"  # Maxwell 2 Xbox dongle (vendor:product as the kernel prints it); the only model tested. See docs/DEVICES.md


# ----------------------------------------------------------------------------------------------------------------------
# Headset presets (HID)
# ----------------------------------------------------------------------------------------------------------------------
def dongle_hidraw():
    """Path of the dongle's /dev/hidrawN node, or None. Matched by USB id in the kernel's uevent files."""
    for u in sorted(glob.glob("/sys/class/hidraw/hidraw*/device/uevent")):
        try:
            if DONGLE_HID in open(u).read().upper():
                return "/dev/" + u.split("/")[4]
        except OSError:
            pass
    return None


def select_preset(value):
    """Select headset preset 1..10 (see PRESETS). Returns True if the report was sent.

    The report is the 62-byte HID output report [06 09 80 | 05 5A 05 00 00 09 00 00 <N>] zero padded. It MUST go out as a
    USB control SET_REPORT (the HIDIOCSOUTPUT ioctl): sent as a plain write() to the hidraw node, a Maxwell 2 only accepts
    1..4 (as EQ slots) and ignores the built-in presets. See docs/PRESETS.md. Needs the udev rule (udev/70-audeze-maxwell.rules).
    """
    path = dongle_hidraw()
    if not path or not 1 <= value <= 10:
        return False
    report = bytes([0x06, 0x09, 0x80, 0x05, 0x5A, 0x05, 0x00, 0x00, 0x09, 0x00, 0x00, value]).ljust(62, b"\x00")
    req = (3 << 30) | (len(report) << 16) | (ord("H") << 8) | 0x0B   # the ioctl number HIDIOCSOUTPUT(len), built by hand
    try:
        fd = os.open(path, os.O_RDWR)
        try:
            fcntl.ioctl(fd, req, bytearray(report))
        finally:
            os.close(fd)
        return True
    except OSError:
        return False


# ----------------------------------------------------------------------------------------------------------------------
# Catalogs, small helpers, background work
# ----------------------------------------------------------------------------------------------------------------------
def read_tsv(path):
    """Rows of a tab-separated catalog file (blank lines skipped). A missing file gives []."""
    try:
        with open(path) as fh:
            return [line.rstrip("\n").split("\t") for line in fh if line.strip()]
    except OSError:
        return []


def read_catalog():
    """Head-response sets: [id, label, zip, inner file, sha256]."""
    return read_tsv(CATALOG)


def read_eq_catalog():
    """Headphone corrections: [id, label, note]."""
    return read_tsv(EQ_CATALOG)


def tilde(path):
    """Show a path under the home folder as ~/... (keeps the user name off the screen and out of screenshots)."""
    home = os.path.expanduser("~")
    return "~" + path[len(home):] if path.startswith(home + os.sep) else path


def run(*args, timeout=15):
    """Run a program and return (exit code, stdout+stderr). Never raises: a missing program or a timeout gives (1, message)."""
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout + r.stderr
    except Exception as e:  # missing binary, timeout
        return 1, str(e)


def bg(fn, *args, then=None, **kwargs):
    """Run fn(*args, **kwargs) in a worker thread; if `then` is given, call then(result) on the GTK main loop afterwards."""
    def work():
        result = fn(*args, **kwargs)
        if then:
            GLib.idle_add(then, result)
    threading.Thread(target=work, daemon=True).start()


# ----------------------------------------------------------------------------------------------------------------------
# Settings (the file shared with bin/tuxwell)
# ----------------------------------------------------------------------------------------------------------------------
DEFAULTS = {"HW_VOLUME": "86", "DISABLE_MIC": "1", "SURROUND_ENABLED": "1", "HIRES": "1", "SURROUND_GAIN": "0.27",
            "LFE_DB": "10", "BASS_DB": "0", "AUTO_DEFAULT": "1", "CTL_PATH": ""}
RANGES = {"HW_VOLUME": (0, 96, int), "SURROUND_GAIN": (0.05, 1.5, float), "LFE_DB": (0, 24, float), "BASS_DB": (0, 12, float)}
FLAGS = ("DISABLE_MIC", "SURROUND_ENABLED", "HIRES", "AUTO_DEFAULT")


def sanitize(c):
    """Replace any invalid setting with its default, so a typo in the file can never stop the app opening.

    Mirrors the checks in bin/tuxwell (which also ignores invalid values) so both agree on what is valid."""
    for k, (lo, hi, kind) in RANGES.items():
        raw = str(c.get(k, DEFAULTS[k])).strip()
        try:
            c[k] = raw if lo <= kind(raw) <= hi else DEFAULTS[k]     # keep exactly what was written (10 stays 10, not 10.0)
        except ValueError:
            c[k] = DEFAULTS[k]
    for k in FLAGS:
        if c.get(k) not in ("0", "1"):
            c[k] = DEFAULTS[k]
    if not re.fullmatch(r"off|[a-z0-9-]+", c.get("EQ", "off")):
        c["EQ"] = "off"
    if "HRTF" in c and not re.fullmatch(r"[A-Za-z0-9._-]+\.sofa", c["HRTF"]):
        del c["HRTF"]
    return c


def read_conf():
    """Load settings: defaults, overridden by the file, then sanitized. Unknown keys (e.g. SURROUND_APPS) are kept."""
    c = dict(DEFAULTS)
    try:
        for line in open(CFG):
            m = re.match(r'\s*([A-Z_]+)=(.*)', line)
            if m:
                c[m.group(1)] = m.group(2).strip().strip('"').strip("'")
    except OSError:
        pass
    return sanitize(c)


def write_conf(c):
    """Write all settings back. Values are shell-quoted so the file stays a valid KEY=value list."""
    os.makedirs(CFG_DIR, exist_ok=True)
    with open(CFG, "w") as f:
        for k, v in c.items():
            f.write(f'{k}={shlex.quote(str(v))}\n')


# ----------------------------------------------------------------------------------------------------------------------
# The audio system: one look at its state, and the plan for switching outputs
# ----------------------------------------------------------------------------------------------------------------------
def audeze_card():
    """ALSA card number of the Audeze dongle. The card's short id is just 'Dongle', so match the long name instead."""
    try:
        with open("/proc/asound/cards") as fh:
            for m in re.finditer(r"^\s*(\d+) \[[^\]]*\]:\s*(.*)$", fh.read(), re.M):
                if "Audeze" in m.group(2):
                    return int(m.group(1))
    except OSError:
        pass
    return None


def audio_state():
    """A snapshot of the audio system, used to draw the status rows and to plan output switches.

    {"sinks": {node name: id}, "headset": the headset's sink name or None, "surround": bool,
     "default": the default sink's name, "rate": the dongle's current sample rate, e.g. "48 kHz"}
    Runs two subprocesses, so call it from a worker thread (bg)."""
    sinks = {}
    for line in run("pactl", "list", "short", "sinks")[1].splitlines():
        parts = line.split("\t")
        if len(parts) > 1:
            sinks[parts[1]] = parts[0]
    headset = next((name for name in sinks if "Audeze" in name), None)
    rate = "-"
    card = audeze_card()
    if headset and card is not None:
        try:
            with open(f"/proc/asound/card{card}/stream0") as fh:
                m = re.search(r"Momentary freq = (\d+) Hz", fh.read())
            rate = f"{int(m.group(1)) / 1000:g} kHz" if m else "idle"
        except OSError:
            pass
    return {"sinks": sinks, "headset": headset, "surround": SURROUND_SINK in sinks,
            "default": run("pactl", "get-default-sink")[1].strip(), "rate": rate}


def volume_percent(text):
    """The first percentage in `pactl get-sink-volume` output, as an int, or None."""
    m = re.search(r"/\s*(\d+)%", text)
    return int(m.group(1)) if m else None


def plan_output_switch(state, to_surround, level, inputs):
    """The pactl commands (argv lists) that make surround or stereo the default output, or None if either is missing.

    One volume across both outputs: the headset sink and the surround sink are in series, so their volumes would
    multiply. The output being left therefore hands its level to the one taking over and returns to 100%.
    Only streams that were on the output being left are moved (never the surround filter's own stream, which must
    keep feeding the headset sink).

    state:  audio_state()    level: volume % of the current default output (or None)
    inputs: the text of `pactl list sink-inputs`
    """
    headset = state["headset"]
    target, other = (SURROUND_SINK, headset) if to_surround else (headset, SURROUND_SINK)
    if not headset or target not in state["sinks"] or other not in state["sinks"]:
        return None
    old = state["default"]
    cmds = []
    if level is not None and old in (target, other) and old != target:
        cmds.append(["pactl", "set-sink-volume", target, f"{level}%"])
        cmds.append(["pactl", "set-sink-volume", old, "100%"])
    cmds.append(["pactl", "set-default-sink", target])
    leaving = state["sinks"][other]                       # id of the output we are leaving
    for block in re.split(r"\n(?=Sink Input #)", inputs):
        stream = re.match(r"\s*Sink Input #(\d+)", block)
        on = re.search(r"^\s*Sink: (\d+)", block, re.M)
        if stream and on and on.group(1) == leaving and not FILTER_STREAM.search(block):
            cmds.append(["pactl", "move-sink-input", stream.group(1), target])
    return cmds


def card_profile_name():
    """Name of the dongle's sound card (what `pactl set-card-profile` needs), or None."""
    for line in run("pactl", "list", "short", "cards")[1].splitlines():
        p = line.split("\t")
        if len(p) > 1 and "Audeze" in p[1]:
            return p[1]
    return None


