        self.conf = read_conf()               # current settings (re-read from disk on every save)
        self.state = {}                       # latest audio_state(), filled in by poll()
        self.polling = False                  # True while a poll is in flight, so polls never overlap
        self.pending = {}                     # debounce timers by key (see debounce)
