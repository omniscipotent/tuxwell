#!/usr/bin/env python3
"""tuxwell-gui: control panel for Audeze Maxwell headsets on Linux (GTK4 + libadwaita)."""
import fcntl, glob, os, re, shlex, subprocess, threading
import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk

CFG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "tuxwell")
CFG = os.path.join(CFG_DIR, "tuxwell.conf")
RATES_ON = "48000 96000"
PRESETS = ["Audeze", "Treble Boost", "Bass Boost", "Immersive", "Competition", "Footsteps",
           "EQ 1 (custom)", "EQ 2 (custom)", "EQ 3 (custom)", "EQ 4 (custom)"]  # value sent = position + 1
DONGLE_HID = "3329:00004B28"  # Maxwell 2 Xbox dongle: the only model tested. See docs/DEVICES.md to add others
DEFAULT_CTL = os.path.expanduser("~/.local/share/tuxwell/audezeforlinux/maxwell_ctl.py")


def dongle_hidraw():
    for u in sorted(glob.glob("/sys/class/hidraw/hidraw*/device/uevent")):
        try:
            if DONGLE_HID in open(u).read().upper():
                return "/dev/" + u.split("/")[4]
        except OSError:
            pass
    return None


def select_preset(value):
    """Select preset 1..10 with a 62-byte report sent as a control SET_REPORT
    (HIDIOCSOUTPUT). The headset ignores built-in presets when this is sent as a plain hidraw write."""
    path = dongle_hidraw()
    if not path or not 1 <= value <= 10:
        return False
    report = bytes([0x06, 0x09, 0x80, 0x05, 0x5A, 0x05, 0x00, 0x00, 0x09, 0x00, 0x00, value]).ljust(62, b"\x00")
    req = (3 << 30) | (len(report) << 16) | (ord("H") << 8) | 0x0B  # HIDIOCSOUTPUT
    try:
        fd = os.open(path, os.O_RDWR)
        try:
            fcntl.ioctl(fd, req, bytearray(report))
        finally:
            os.close(fd)
        return True
    except OSError:
        return False


CATALOG = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "tuxwell", "hrtf-catalog.tsv")


def read_catalog():
    """[(id, label, zip, inner, sha256)] of the available head-response sets."""
    try:
        return [l.rstrip("\n").split("\t") for l in open(CATALOG) if l.strip()]
    except OSError:
        return []


EQ_CATALOG = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "tuxwell", "eq", "catalog.tsv")


def read_eq_catalog():
    """[(id, label, note)] of the headphone corrections."""
    try:
        return [l.rstrip("\n").split("\t") for l in open(EQ_CATALOG) if l.strip()]
    except OSError:
        return []


def tilde(path):
    home = os.path.expanduser("~")
    return "~" + path[len(home):] if path.startswith(home + os.sep) else path


def run(*args, timeout=15):
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout + r.stderr
    except Exception as e:  # missing binary, timeout
        return 1, str(e)


DEFAULTS = {"HW_VOLUME": "86", "DISABLE_MIC": "1", "SURROUND_ENABLED": "1", "HIRES": "1", "SURROUND_GAIN": "0.27",
            "LFE_DB": "10", "BASS_DB": "0", "AUTO_DEFAULT": "1", "CTL_PATH": ""}
RANGES = {"HW_VOLUME": (0, 96, int), "SURROUND_GAIN": (0.05, 1.5, float), "LFE_DB": (0, 24, float), "BASS_DB": (0, 12, float)}
FLAGS = ("DISABLE_MIC", "SURROUND_ENABLED", "HIRES", "AUTO_DEFAULT")


def sanitize(c):
    """Replace any invalid setting with its default, so a typo in the file can never stop the app opening."""
    for k, (lo, hi, kind) in RANGES.items():
        try:
            v = kind(c.get(k, DEFAULTS[k]))
            c[k] = str(v) if lo <= v <= hi else DEFAULTS[k]
        except (TypeError, ValueError):
            c[k] = DEFAULTS[k]
    for k in FLAGS:
        if c.get(k) not in ("0", "1"):
            c[k] = DEFAULTS[k]
    if not re.fullmatch(r"off|[a-z0-9-]+", c.get("EQ", "off")):
        c["EQ"] = "off"
    if "HRTF" in c and not re.fullmatch(r"[A-Za-z0-9._-]+\.sofa", c["HRTF"]):
        del c["HRTF"]
    return c


def read_conf():
    c = dict(DEFAULTS)
    try:
        for line in open(CFG):
            m = re.match(r'\s*([A-Z_]+)=(.*)', line)
            if m:
                c[m.group(1)] = m.group(2).strip().strip('"').strip("'")
    except OSError:
        pass
    return sanitize(c)


def write_conf(c):
    os.makedirs(CFG_DIR, exist_ok=True)
    with open(CFG, "w") as f:
        for k, v in c.items():
            f.write(f'{k}={shlex.quote(str(v))}\n')


def audeze_card():
    """ALSA card number of the Audeze dongle (the card id is just 'Dongle', so match the long name)."""
    try:
        for m in re.finditer(r"^\s*(\d+) \[[^\]]*\]:\s*(.*)$", open("/proc/asound/cards").read(), re.M):
            if "Audeze" in m.group(2):
                return int(m.group(1))
    except OSError:
        pass
    return None


def sinks():
    return run("pactl", "list", "short", "sinks")[1]


def sink_name(match):
    for line in sinks().splitlines():
        p = line.split("\t")
        if len(p) > 1 and match in p[1]:
            return p[1]
    return None


def card_profile_name():
    for line in run("pactl", "list", "short", "cards")[1].splitlines():
        p = line.split("\t")
        if len(p) > 1 and "Audeze" in p[1]:
            return p[1]
    return None


class Win(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Tuxwell", default_width=560, default_height=int(os.environ.get("MAXWELL_HEIGHT", "780")))
        self.conf = read_conf()
        self.busy = False
        self.timer = None
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        self.toast = Adw.ToastOverlay()
        self.toast.set_child(view)
        self.set_content(self.toast)
        self.stack = Adw.ViewStack()
        view.set_content(self.stack)
        view.add_bottom_bar(Adw.ViewSwitcherBar(stack=self.stack, reveal=True))

        def tab(name, title, icon):
            pg = Adw.PreferencesPage()
            self.stack.add_titled_with_icon(pg, name, title, icon)
            return pg

        def group(pg, title, desc=None):
            g = Adw.PreferencesGroup(title=title)
            if desc:
                g.set_description(desc)
            pg.add(g)
            return g

        def slider(lo, hi, step, value, cb, fmt=None, digits=0):
            sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, step)
            sc.set_value(value)
            sc.set_size_request(200, -1)
            sc.set_valign(Gtk.Align.CENTER)
            sc.set_draw_value(True)
            sc.set_digits(digits)
            if fmt:
                sc.set_format_value_func(fmt)
            sid = sc.connect("value-changed", cb)
            return sc, sid

        # ============ Listen: what is playing, where, how loud
        pg = tab("listen", "Listen", "audio-headphones-symbolic")
        g = group(pg, "Right now")
        self.r_conn = Adw.ActionRow(title="Headset")
        self.r_rate = Adw.ActionRow(title="Sample rate")
        self.r_surr = Adw.ActionRow(title="Surround")
        for r in (self.r_conn, self.r_rate, self.r_surr):
            r.add_css_class("property")
            g.add(r)
        g = group(pg, "Output", "Where your sound goes")
        self.s_auto = self.switch_row("Follow playback", "Surround while Plex HTPC plays, stereo again when it pauses. Your volume carries across.",
                                      self.conf["AUTO_DEFAULT"] == "1", self.on_auto)
        g.add(self.s_auto)
        self.r_out = Adw.ComboRow(title="Choose it yourself", subtitle="Used when Follow playback is off",
                                  model=Gtk.StringList.new(["Stereo", "Surround 7.1 (virtual)"]))
        self.out_id = self.r_out.connect("notify::selected", self.on_output)
        g.add(self.r_out)
        g = group(pg, "Volume")
        self.r_vol = Adw.ActionRow(title="Headset volume", subtitle="The headset's own gain. 100% is the loudest it can go.")
        self.scale, self.vol_id = slider(0, 96, 1, int(self.conf["HW_VOLUME"]), self.on_volume, lambda s, v: f"{round(v / 96 * 100)}%")
        self.r_vol.add_suffix(self.scale)
        g.add(self.r_vol)

        # ============ Surround: the "find your sound" workflow
        pg = tab("surround", "Surround", "audio-speakers-symbolic")
        g = group(pg, "Virtual surround", "Makes movies and games sound like they come from all around you")
        self.s_surr = self.switch_row("Virtual surround", "Adds the Tuxwell Surround (7.1) output", self.conf["SURROUND_ENABLED"] == "1", self.on_surround)
        g.add(self.s_surr)
        self.r_gain = Adw.ActionRow(title="Surround level", subtitle="Raise it if surround sounds quiet next to stereo. Applies after a moment.")
        self.gain, _ = slider(0.10, 0.60, 0.05, float(self.conf["SURROUND_GAIN"]), self.on_gain, digits=2)
        self.r_gain.add_suffix(self.gain)
        g.add(self.r_gain)
        g = group(pg, "Bass", "Movies keep their rumble in a separate bass channel. These two controls add punch.")
        self.r_lfe = Adw.ActionRow(title="Bass channel (5.1 / 7.1 movies)", subtitle="Explosions and rumble. A cinema plays this about 10 dB louder than the rest, so higher is truer to the mix.")
        self.lfe, _ = slider(0, 20, 1, float(self.conf["LFE_DB"]), self.on_lfe, lambda s, v: f"+{int(v)} dB")
        self.r_lfe.add_suffix(self.lfe)
        g.add(self.r_lfe)
        self.r_bass = Adw.ActionRow(title="Bass boost (everything)", subtitle="A gentle lift of the low end for music, games and shows. 0 leaves it as is.")
        self.bass, _ = slider(0, 9, 1, float(self.conf["BASS_DB"]), self.on_bass, lambda s, v: f"+{int(v)} dB")
        self.r_bass.add_suffix(self.bass)
        g.add(self.r_bass)
        g = group(pg, "Find your sound", "Everyone's ears and headphones differ. Work down this list: pick a head response, press Play to hear it, then try the correction.")
        self.catalog = read_catalog()
        if self.catalog:
            self.r_hrtf = Adw.ComboRow(title="1. Head response", subtitle="Shapes how sounds are placed around you. Try a few.",
                                       model=Gtk.StringList.new([c[1] for c in self.catalog]))
            cur = (self.conf.get("HRTF") or "D1_48K_24bit_256tap_FIR_SOFA.sofa")
            for i, c in enumerate(self.catalog):
                if c[3].endswith("/" + cur):
                    self.r_hrtf.set_selected(i)
            self.hrtf_id = self.r_hrtf.connect("notify::selected", self.on_hrtf)
            g.add(self.r_hrtf)
            self.r_test = Adw.ActionRow(title="2. Test sound", subtitle="Noise bursts circle around you, then alternate front and back. Keep the volume modest.")
            tb = Gtk.Button(label="Play", valign=Gtk.Align.CENTER)
            tb.connect("clicked", self.on_test)
            self.r_test.add_suffix(tb)
            g.add(self.r_test)
        self.eq_catalog = read_eq_catalog()
        if self.eq_catalog:
            labels = ["Off"] + [c[1] for c in self.eq_catalog]
            self.r_eq = Adw.ComboRow(title="3. Headphone correction", subtitle="Evens out the headphones' own sound. Assumes the Audeze sound preset.",
                                     model=Gtk.StringList.new(labels))
            cur_eq = self.conf.get("EQ", "off")
            for i, c in enumerate(self.eq_catalog, 1):
                if c[0] == cur_eq:
                    self.r_eq.set_selected(i)
            self.eq_id = self.r_eq.connect("notify::selected", self.on_eq)
            g.add(self.r_eq)

        # ============ Headset: stored in the headset itself
        pg = tab("headset", "Headset", "audio-card-symbolic")
        self.g_hs = group(pg, "On the headset", "These are stored in the headset. They need audezeforlinux (see Setup below).")
        self.r_preset = Adw.ComboRow(title="Sound preset", subtitle="Built-in presets and your four EQ slots",
                                     model=Gtk.StringList.new(PRESETS))
        self.preset_id = self.r_preset.connect("notify::selected", self.on_preset)
        self.r_side = Adw.ActionRow(title="Sidetone", subtitle="Hear your own mic. 0 is off, up to 31.")
        self.side, self.side_id = slider(0, 31, 1, 0, self.on_side)
        self.r_side.add_suffix(self.side)
        self.r_chat = Adw.ActionRow(title="Game / chat mix", subtitle="Left is all game, right is all chat")
        self.chat, self.chat_id = slider(0, 100, 5, 50, self.on_chat)
        self.r_chat.add_suffix(self.chat)
        self.r_info = Adw.ActionRow(title="Battery and firmware")
        self.r_info.add_css_class("property")
        for r in (self.r_preset, self.r_side, self.r_chat, self.r_info):
            self.g_hs.add(r)
        btn = Gtk.Button(label="Refresh", valign=Gtk.Align.CENTER)
        btn.connect("clicked", lambda *_: self.read_headset())
        self.r_info.add_suffix(btn)
        g = group(pg, "Setup", "Only needed for the settings above")
        self.r_path = Adw.EntryRow(title="Path to maxwell_ctl.py (audezeforlinux)")
        self.r_path.set_text(tilde(self.conf["CTL_PATH"] or (DEFAULT_CTL if os.path.exists(DEFAULT_CTL) else "")))
        self.r_path.connect("apply", self.on_path)
        self.r_path.set_show_apply_button(True)
        g.add(self.r_path)

        # ============ More: options and help
        pg = tab("more", "More", "preferences-system-symbolic")
        g = group(pg, "Audio options", "Applied whenever the headset powers on")
        self.s_hires = self.switch_row("Hi-res audio", "Switch between 48 and 96 kHz to match what is playing", self.conf["HIRES"] == "1", self.on_hires)
        self.s_mic = self.switch_row("Hide the headset mic", "Playback only, so the mic never shows up as an input", self.conf["DISABLE_MIC"] == "1", self.on_mic)
        g.add(self.s_hires)
        g.add(self.s_mic)
        g = group(pg, "Help")
        for title, sub, label, fn in (
            ("Read the guide", "Setup, settings and how it all works", "Open", lambda *_: self.open_url("https://github.com/omniscipotent/tuxwell#readme")),
            ("Choosing a head response", "How to find the set that suits your ears", "Open", lambda *_: self.open_url("https://github.com/omniscipotent/tuxwell/blob/main/docs/HRTF.md")),
            ("Something wrong?", "Copies a short, non-personal report you can paste into an issue", "Copy report", self.on_copy_report),
            ("Report an issue or ask for a device", "Opens GitHub", "Open", lambda *_: self.open_url("https://github.com/omniscipotent/tuxwell/issues")),
        ):
            r = Adw.ActionRow(title=title, subtitle=sub)
            b = Gtk.Button(label=label, valign=Gtk.Align.CENTER)
            b.connect("clicked", fn)
            r.add_suffix(b)
            g.add(r)
        g = group(pg, "About")
        r = Adw.ActionRow(title="Tuxwell", subtitle="Open source (MIT). Not affiliated with Audeze. Head responses: SADIE II, University of York. Corrections: AutoEq and SoundGuys data.")
        g.add(r)

        self.stack.set_visible_child_name(os.environ.get("MAXWELL_TAB", "listen"))
        shot = os.environ.get("MAXWELL_SCREENSHOT")
        if shot:
            self.unmaximize()
            self.set_default_size(560, int(os.environ.get("MAXWELL_HEIGHT", "780")))
            self.set_size_request(560, int(os.environ.get("MAXWELL_HEIGHT", "780")))
            GLib.timeout_add(2500, self.screenshot, shot)
        self.pending = {}
        self.refresh()
        GLib.timeout_add_seconds(2, self.refresh)
        self.read_headset()

    def screenshot(self, path):
        self.set_focus(None)
        paintable = Gtk.WidgetPaintable.new(self)
        w, h = self.get_width(), self.get_height()
        snap = Gtk.Snapshot()
        paintable.snapshot(snap, w, h)
        node = snap.to_node()
        tex = self.get_native().get_renderer().render_texture(node, None)
        tex.save_to_png(path)
        self.get_application().quit()
        return False

    # helpers
    def switch_row(self, title, sub, active, cb):
        r = Adw.SwitchRow(title=title, subtitle=sub)
        r.set_active(active)
        r.connect("notify::active", cb)
        return r

    def say(self, msg):
        self.toast.add_toast(Adw.Toast(title=msg, timeout=3))

    def save(self, **kw):
        c = read_conf()                      # re-read: other tools (tuxwell-hrtf) also write this file
        c.update({k: str(v) for k, v in kw.items()})
        self.conf = c
        write_conf(c)

    def debounce(self, key, fn, ms=350):
        if key in self.pending:
            GLib.source_remove(self.pending[key])
        def go():
            self.pending.pop(key, None)
            fn()
            return False
        self.pending[key] = GLib.timeout_add(ms, go)

    # status
    def refresh(self):
        dev = sink_name("Audeze") is not None
        self.r_conn.set_subtitle("Connected" if dev else "Headset is off or not connected")
        rate = "-"
        n = audeze_card()
        if dev and n is not None:
            try:
                m = re.search(r"Momentary freq = (\d+) Hz", open(f"/proc/asound/card{n}/stream0").read())
                rate = f"{int(m.group(1))/1000:g} kHz" if m else "idle"
            except OSError:
                pass
        self.r_rate.set_subtitle(rate)
        surr = sink_name("tuxwell_surround") is not None
        self.r_surr.set_subtitle("Active" if surr else "Not running")
        self.r_out.set_sensitive(dev and self.conf.get("AUTO_DEFAULT", "1") != "1")
        if dev:
            d = run("pactl", "get-default-sink")[1].strip()
            want = 1 if "tuxwell_surround" in d else 0
            if self.r_out.get_selected() != want and d:
                self.r_out.handler_block(self.out_id)
                self.r_out.set_selected(want)
                self.r_out.handler_unblock(self.out_id)
        return True

    # audio actions
    def sink_pct(self, name):
        out = run("pactl", "get-sink-volume", name)[1]
        m = re.search(r"/\s*(\d+)%", out)
        return int(m.group(1)) if m else None

    def on_output(self, row, _):
        to_surround = row.get_selected() == 1
        target = sink_name("tuxwell_surround") if to_surround else sink_name("Audeze")
        other = sink_name("Audeze") if to_surround else sink_name("tuxwell_surround")
        if not target or not other:
            self.say("That output isn't available right now")
            return
        # One volume for both: the sink you are leaving hands its level to the one you switch to
        # and goes back to 100%, so the two stages never stack and stereo/surround stay equally loud.
        old = run("pactl", "get-default-sink")[1].strip()
        level = self.sink_pct(old) if old in (target, other) else None
        if level is not None and old != target:
            run("pactl", "set-sink-volume", target, f"{level}%")
            run("pactl", "set-sink-volume", old, "100%")
        run("pactl", "set-default-sink", target)
        # Move only the streams that were on the output we are leaving, and never the surround filter's own stream.
        left = next((l.split("\t")[0] for l in run("pactl", "list", "short", "sinks")[1].splitlines()
                     if l.split("\t")[1:2] == [other]), None)
        for blk in re.split(r"\n(?=Sink Input #)", run("pactl", "list", "sink-inputs")[1]):
            m = re.match(r"\s*Sink Input #(\d+)", blk)
            on = re.search(r"^\s*Sink: (\d+)", blk, re.M)
            if m and on and on.group(1) == left and "tuxwell_surround" not in blk:
                run("pactl", "move-sink-input", m.group(1), target)

    def on_volume(self, scale):
        v = int(scale.get_value())
        def apply():
            n = audeze_card()
            if n is None:
                self.say("Headset not connected, saved for next time")
            else:
                for i in (0, 1):
                    run("amixer", "-c", str(n), "sset", f"PCM,{i}", str(v))
            self.save(HW_VOLUME=v)
        self.debounce("vol", apply)

    def on_auto(self, row, _):
        self.save(AUTO_DEFAULT=int(row.get_active()))
        self.r_out.set_sensitive(sink_name("Audeze") is not None and not row.get_active())
        run("systemctl", "--user", "restart", "tuxwell.service")
        self.say("Following playback" if row.get_active() else "Output is manual")

    def on_hires(self, row, _):
        on = row.get_active()
        run("pw-metadata", "-n", "settings", "0", "clock.allowed-rates", f"[ {RATES_ON if on else '48000'} ]")
        self.save(HIRES=int(on))

    def on_mic(self, row, _):
        on = row.get_active()
        card = card_profile_name()
        if card:
            run("pactl", "set-card-profile", card,
                "output:iec958-stereo" if on else "output:iec958-stereo+input:mono-fallback")
        self.save(DISABLE_MIC=int(on))

    def open_url(self, url):
        subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def on_copy_report(self, _btn):
        rc, out = run("tuxwell-report", timeout=20)
        if rc == 0 or out:
            self.get_clipboard().set(out)
            self.say("Report copied. Paste it into your issue.")
        else:
            self.say("Couldn't build the report")

    def on_eq(self, row, _):
        n = row.get_selected()
        if n == Gtk.INVALID_LIST_POSITION:
            return
        eq_id = "off" if n == 0 else self.eq_catalog[n - 1][0]
        self.save(EQ=eq_id)
        self.say("Correction off" if n == 0 else f"Correction: {self.eq_catalog[n - 1][1]}")
        run("systemctl", "--user", "restart", "tuxwell.service")

    def on_hrtf(self, row, _):
        n = row.get_selected()
        if n == Gtk.INVALID_LIST_POSITION or n >= len(self.catalog):
            return
        sid, label = self.catalog[n][0], self.catalog[n][1]
        self.say(f"Switching to {label} (downloads if needed)...")
        def work():
            rc, out = run("tuxwell-hrtf", "use", sid, timeout=600)
            GLib.idle_add(self.say, f"Now using {label}" if rc == 0 else f"Couldn't switch: {out.strip()[-80:]}")
        threading.Thread(target=work, daemon=True).start()

    def on_test(self, _btn):
        self.say("Playing the test sound")
        threading.Thread(target=run, args=("tuxwell-test-sound",), kwargs={"timeout": 60}, daemon=True).start()

    def _tune(self, key, value, label):
        def apply():
            self.save(**{key: value})
            if self.conf.get("SURROUND_ENABLED") == "1":
                threading.Thread(target=run, args=("systemctl", "--user", "restart", "tuxwell.service"), daemon=True).start()
                self.say(f"{label} +{value:g} dB")
        self.debounce(key, apply, 1200)

    def on_lfe(self, scale):
        self._tune("LFE_DB", round(scale.get_value()), "Bass channel")

    def on_bass(self, scale):
        self._tune("BASS_DB", round(scale.get_value()), "Bass boost")

    def on_gain(self, scale):
        v = round(scale.get_value(), 2)
        def apply():
            self.save(SURROUND_GAIN=v)
            if self.conf.get("SURROUND_ENABLED") == "1":
                threading.Thread(target=run, args=("systemctl", "--user", "restart", "tuxwell.service"), daemon=True).start()
                self.say(f"Surround level {v:g}")
        self.debounce("gain", apply, 1200)

    def on_surround(self, row, _):
        self.save(SURROUND_ENABLED=int(row.get_active()))
        run("systemctl", "--user", "restart", "tuxwell.service")
        self.say("Surround " + ("on" if row.get_active() else "off"))

    # headset (maxwell_ctl)
    def ctl(self):
        p = os.path.expanduser(self.r_path.get_text().strip())
        return p if p and os.path.isfile(p) else None

    def on_path(self, row):
        self.save(CTL_PATH=row.get_text().strip())
        self.read_headset()

    def ctl_run(self, *args, then=None):
        p = self.ctl()
        if not p:
            self.say("Set the path to maxwell_ctl.py first")
            return
        def work():
            rc, out = self._run_in_dir(p, *args)
            if then:
                GLib.idle_add(then, rc, out)
        threading.Thread(target=work, daemon=True).start()

    def _run_in_dir(self, p, *args):
        try:
            r = subprocess.run(["python3", p, "--plain", *args], capture_output=True, text=True,
                               timeout=30, cwd=os.path.dirname(p))
            return r.returncode, r.stdout + r.stderr
        except Exception as e:
            return 1, str(e)

    def read_headset(self):
        has = self.ctl() is not None
        for r in (self.r_preset, self.r_side, self.r_chat):
            r.set_sensitive(has)
        if not has:
            self.r_info.set_subtitle("Clone audezeforlinux and set the path above")
            return
        def done(rc, out):
            if rc != 0 or "Battery" not in out:
                self.r_info.set_subtitle("No answer from the headset (is it on?)")
                return
            def f(label):
                m = re.search(label + r"\s*:\s*(.+)", out)
                return m.group(1).strip() if m else ""
            self.r_info.set_subtitle(f"Battery {f('Battery Level')}   Firmware {f('Firmware Version')}")
            pr = f("Active Preset")
            m = re.search(r"\[(\d+)\]", pr)
            idx = int(m.group(1)) if m else None
            st = re.search(r"Level (\d+)/31", f("Sidetone"))
            ch = re.search(r"Chat (\d+)%", f("Game / Chat Mix"))
            self.r_preset.handler_block(self.preset_id)
            if idx is not None and 1 <= idx <= 10:
                self.r_preset.set_selected(idx - 1)
            self.r_preset.handler_unblock(self.preset_id)
            if st:
                on = f("Sidetone").startswith("ON")
                self.side.handler_block(self.side_id); self.side.set_value(int(st.group(1)) if on else 0)
                self.side.handler_unblock(self.side_id)
            if ch:
                self.chat.handler_block(self.chat_id); self.chat.set_value(int(ch.group(1)))
                self.chat.handler_unblock(self.chat_id)
        self.ctl_run("status", then=done)

    def on_preset(self, row, _):
        n = row.get_selected()
        if n == Gtk.INVALID_LIST_POSITION:
            return
        if not select_preset(n + 1):
            self.say("Couldn't reach the headset (is it on, and is the udev rule installed?)")
            return
        self.say(PRESETS[n])
        GLib.timeout_add_seconds(2, lambda: (self.read_headset(), False)[1])

    def on_side(self, s):
        v = int(s.get_value())
        self.debounce("side", lambda: self.ctl_run("sidetone", "off" if v == 0 else str(v)))

    def on_chat(self, s):
        v = int(s.get_value())
        self.debounce("chat", lambda: self.ctl_run("chatmix", str(v)))



SNI_XML = """<node>
 <interface name="org.kde.StatusNotifierItem">
  <property name="Category" type="s" access="read"/>
  <property name="Id" type="s" access="read"/>
  <property name="Title" type="s" access="read"/>
  <property name="Status" type="s" access="read"/>
  <property name="WindowId" type="i" access="read"/>
  <property name="IconName" type="s" access="read"/>
  <property name="IconThemePath" type="s" access="read"/>
  <property name="OverlayIconName" type="s" access="read"/>
  <property name="AttentionIconName" type="s" access="read"/>
  <property name="ItemIsMenu" type="b" access="read"/>
  <property name="Menu" type="o" access="read"/>
  <method name="Activate"><arg type="i" direction="in"/><arg type="i" direction="in"/></method>
  <method name="SecondaryActivate"><arg type="i" direction="in"/><arg type="i" direction="in"/></method>
  <method name="ContextMenu"><arg type="i" direction="in"/><arg type="i" direction="in"/></method>
  <method name="Scroll"><arg type="i" direction="in"/><arg type="s" direction="in"/></method>
  <signal name="NewIcon"/><signal name="NewStatus"><arg type="s"/></signal>
 </interface></node>"""

MENU_XML = """<node>
 <interface name="com.canonical.dbusmenu">
  <property name="Version" type="u" access="read"/>
  <property name="TextDirection" type="s" access="read"/>
  <property name="Status" type="s" access="read"/>
  <property name="IconThemePath" type="as" access="read"/>
  <method name="GetLayout"><arg type="i" direction="in"/><arg type="i" direction="in"/><arg type="as" direction="in"/>
   <arg type="u" direction="out"/><arg type="(ia{sv}av)" direction="out"/></method>
  <method name="GetGroupProperties"><arg type="ai" direction="in"/><arg type="as" direction="in"/>
   <arg type="a(ia{sv})" direction="out"/></method>
  <method name="GetProperty"><arg type="i" direction="in"/><arg type="s" direction="in"/><arg type="v" direction="out"/></method>
  <method name="Event"><arg type="i" direction="in"/><arg type="s" direction="in"/><arg type="v" direction="in"/><arg type="u" direction="in"/></method>
  <method name="EventGroup"><arg type="a(isvu)" direction="in"/><arg type="ai" direction="out"/></method>
  <method name="AboutToShow"><arg type="i" direction="in"/><arg type="b" direction="out"/></method>
  <method name="AboutToShowGroup"><arg type="ai" direction="in"/><arg type="ai" direction="out"/><arg type="ai" direction="out"/></method>
  <signal name="LayoutUpdated"><arg type="u"/><arg type="i"/></signal>
 </interface></node>"""

ICON_NAME = "io.github.omniscipotent.Tuxwell"


class Tray:
    """Minimal StatusNotifierItem (the tray protocol used by Discord, qBittorrent, Proton...)."""

    def __init__(self, on_toggle, on_quit):
        self.on_toggle, self.on_quit = on_toggle, on_quit
        self.items = [(1, "Show / hide Tuxwell"), (2, "Quit")]
        self.ok = False
        try:
            self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
            self.name = f"org.kde.StatusNotifierItem-{os.getpid()}-1"
            Gio.bus_own_name_on_connection(self.bus, self.name, Gio.BusNameOwnerFlags.NONE, None, None)
            self.bus.register_object("/StatusNotifierItem", Gio.DBusNodeInfo.new_for_xml(SNI_XML).interfaces[0],
                                     self.sni_call, self.sni_get, None)
            self.bus.register_object("/MenuBar", Gio.DBusNodeInfo.new_for_xml(MENU_XML).interfaces[0],
                                     self.menu_call, self.menu_get, None)
            self.bus.call("org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher", "org.kde.StatusNotifierWatcher",
                          "RegisterStatusNotifierItem", GLib.Variant("(s)", (self.name,)), None,
                          Gio.DBusCallFlags.NONE, 2000, None, self._registered)
        except Exception as e:  # no tray available: the app still works without it
            print("tray unavailable:", e)

    def _registered(self, bus, res):
        try:
            bus.call_finish(res)
            self.ok = True
        except Exception as e:
            print("tray not registered (is a tray extension enabled?):", e)

    # StatusNotifierItem
    def sni_get(self, conn, sender, path, iface, prop):
        v = {"Category": ("s", "Hardware"), "Id": ("s", "tuxwell"), "Title": ("s", "Tuxwell"),
             "Status": ("s", "Active"), "WindowId": ("i", 0), "IconName": ("s", ICON_NAME),
             "IconThemePath": ("s", ""), "OverlayIconName": ("s", ""), "AttentionIconName": ("s", ""),
             "ItemIsMenu": ("b", False), "Menu": ("o", "/MenuBar")}.get(prop)
        return GLib.Variant(*v) if v else None

    def sni_call(self, conn, sender, path, iface, method, params, inv):
        if method in ("Activate", "SecondaryActivate"):
            GLib.idle_add(self.on_toggle)
        inv.return_value(None)

    # dbusmenu
    def _item(self, i, label):
        return GLib.Variant("(ia{sv}av)", (i, {"label": GLib.Variant("s", label), "enabled": GLib.Variant("b", True),
                                              "visible": GLib.Variant("b", True)}, []))

    def menu_get(self, conn, sender, path, iface, prop):
        return {"Version": GLib.Variant("u", 3), "TextDirection": GLib.Variant("s", "ltr"),
                "Status": GLib.Variant("s", "normal"), "IconThemePath": GLib.Variant("as", [])}.get(prop)

    def menu_call(self, conn, sender, path, iface, method, params, inv):
        if method == "GetLayout":
            kids = [self._item(i, l) for i, l in self.items]
            root = (0, {"children-display": GLib.Variant("s", "submenu")}, kids)
            inv.return_value(GLib.Variant("(u(ia{sv}av))", (1, root)))
        elif method == "GetGroupProperties":
            inv.return_value(GLib.Variant("(a(ia{sv}))", ([(i, {"label": GLib.Variant("s", l)}) for i, l in self.items],)))
        elif method == "GetProperty":
            inv.return_value(GLib.Variant("(v)", (GLib.Variant("s", ""),)))
        elif method == "Event":
            i, event = params.unpack()[0], params.unpack()[1]
            if event == "clicked":
                GLib.idle_add(self.on_toggle if i == 1 else self.on_quit)
            inv.return_value(None)
        elif method == "AboutToShow":
            inv.return_value(GLib.Variant("(b)", (False,)))
        elif method == "AboutToShowGroup":
            inv.return_value(GLib.Variant("(aiai)", ([], [])))
        elif method == "EventGroup":
            for i, event, _, _ in params.unpack()[0]:
                if event == "clicked":
                    GLib.idle_add(self.on_toggle if i == 1 else self.on_quit)
            inv.return_value(GLib.Variant("(ai)", ([],)))
        else:
            inv.return_value(None)


class App(Adw.Application):
    def __init__(self):
        flags = Gio.ApplicationFlags.NON_UNIQUE if os.environ.get("MAXWELL_SCREENSHOT") else Gio.ApplicationFlags.DEFAULT_FLAGS
        super().__init__(application_id="io.github.omniscipotent.Tuxwell", flags=flags)
        self.tray = None
        self.win = None

    def do_activate(self):
        win = self.win
        if win is None:
            win = self.win = Win(self)
            if not os.environ.get("MAXWELL_SCREENSHOT"):
                win.connect("close-request", self.on_close)   # closing hides to the tray
                self.hold()
                self.tray = Tray(self.toggle, self.quit)
        win.present()

    def on_close(self, win):
        if self.tray and self.tray.ok:
            win.set_visible(False)
            return True
        return False

    def toggle(self):
        win = self.win
        if win:
            win.set_visible(False) if win.get_visible() and win.is_active() else win.present()
        return False


if __name__ == "__main__":
    App().run()
